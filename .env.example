# Discord bot authentication token
DISCORD_TOKEN=<<your-bot-token>>

# Comma-separated Discord role IDs authorized to manage projects and mention bot
DISCORD_CREATE_ROLE_IDS=123,456

# Discord forum channel ID for project threads
DISCORD_LOCALIZE_NSW_CHANNEL_ID=1568872535125393458

# Directory root for project workspaces (defaults to projects)
PROJECTS_ROOT=projects
